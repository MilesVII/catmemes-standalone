# Network. Keep HOST on loopback when fronted by nginx.
HOST=127.0.0.1
PORT=3000

# Storage (relative paths resolve against the working directory).
DB_PATH=./data/gatos.db
MEDIA_DIR=./data/media

# Shared secret for the feeder (x-feed-token header). Replaces the KV "feed-token" entry.
FEED_TOKEN=change-me

# Set to "false" only for plain-http local development; the auth cookie is Secure otherwise.
COOKIE_SECURE=true

# Tag suggestions: site-wide gap between two publicly issued suggester tokens,
# and how long a token stays valid. Admin-issued links ignore the cooldown.
SUGGEST_COOLDOWN_HOURS=6
SUGGEST_TTL_DAYS=7
