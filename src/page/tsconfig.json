{
	"compilerOptions": {
		/* The page is bundled by esbuild (npm run build), so imports resolve the
		   way a bundler does: no file extensions needed. */
		"target": "es2022",
		"lib": ["dom", "dom.iterable", "es2022"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["./**/*.ts"]
}
